<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
                   logicalFilePath="config/liquibase/changelog/platform/knowledge_base/20260831000001_platform_knowledge_base_owner_unique_index.xml">

    <!--
        The owner now sits in knowledge_base's registry key (name, platform_type, environment, owner_id,
        owner_type), because two connected users may each own a "docs" knowledge base. Postgres treats every NULL
        owner_id as distinct, so a single non-partial unique index would never fire for shared (owner_id IS NULL)
        rows: two concurrent creates of the same shared name would both succeed. That is why this is two indexes:
        one plain unique index covering owned rows, and one partial unique index covering shared rows.

        owner_type is in the owned index because an owner IS the pair, not the id: isReadableBy compares id AND
        type, so on the day a second OwnerType is appended, two owners of different types sharing an id are two
        different owners. A key that could not tell them apart would refuse the second one's knowledge base as a
        duplicate of the first one's.

        It is deliberately absent from the shared index below. That index constrains exactly the rows whose
        owner_id IS NULL, and nothing else keys off owner_type for them; adding it as a column would weaken the
        constraint, since a row with a stray owner_type but no owner_id must still collide with a plain shared row
        of the same name.
    -->
    <!--
        Liquibase cannot auto-rollback a dropUniqueConstraint, so without this block a rollback would fail at the
        first changeset, having already dropped the two indexes below and leaving the database with neither the new
        key nor the old one.
    -->
    <changeSet id="20260831000001-1" author="Ivica Cardic">
        <dropUniqueConstraint tableName="knowledge_base" constraintName="uk_knowledge_base_name_platform_type_environment"/>
        <rollback>
            <addUniqueConstraint
                tableName="knowledge_base" columnNames="name, platform_type, environment"
                constraintName="uk_knowledge_base_name_platform_type_environment"/>
        </rollback>
    </changeSet>

    <changeSet id="20260831000001-2" author="Ivica Cardic">
        <createIndex indexName="uk_knowledge_base_name_platform_type_environment_owner" tableName="knowledge_base" unique="true">
            <column name="name"/>
            <column name="platform_type"/>
            <column name="environment"/>
            <column name="owner_id"/>
            <column name="owner_type"/>
        </createIndex>
    </changeSet>

    <!--
        Its position among these changesets does not matter: uk_knowledge_base_name_environment does not prevent the
        indexes here from being created, it prevents rows from being inserted afterwards.

        It comes from 20260831000001_platform_knowledge_base_name_unique_per_environment, which reached 0_732
        separately while this branch was in flight. That changeset keys the name on (name, environment) alone, with
        neither platform_type nor owner_id, so on a merged tree it would survive both index creations and then forbid
        exactly what they exist to allow: the same name in both pools, and two accounts each owning a "docs". Its own
        drop of uk_knowledge_base_name MARK_RANs harmlessly here, because 20260829000001 already removed that.

        Preconditioned because the constraint exists only where that changeset ran.
    -->
    <changeSet id="20260831000001-4" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <uniqueConstraintExists tableName="knowledge_base" constraintName="uk_knowledge_base_name_environment"/>
        </preConditions>

        <dropUniqueConstraint tableName="knowledge_base" constraintName="uk_knowledge_base_name_environment"/>

        <rollback>
            <addUniqueConstraint
                tableName="knowledge_base" columnNames="name, environment"
                constraintName="uk_knowledge_base_name_environment"/>
        </rollback>
    </changeSet>

    <changeSet id="20260831000001-3" author="Ivica Cardic">
        <sql>
            CREATE UNIQUE INDEX uk_knowledge_base_name_platform_type_environment_shared
            ON knowledge_base (name, platform_type, environment) WHERE owner_id IS NULL
        </sql>
        <rollback>
            DROP INDEX IF EXISTS uk_knowledge_base_name_platform_type_environment_shared
        </rollback>
    </changeSet>
</databaseChangeLog>
