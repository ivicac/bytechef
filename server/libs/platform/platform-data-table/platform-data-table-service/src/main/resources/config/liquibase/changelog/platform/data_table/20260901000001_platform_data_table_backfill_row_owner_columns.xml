<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
                   logicalFilePath="config/liquibase/changelog/platform/data_table/20260901000001_platform_data_table_backfill_row_owner_columns.xml">

    <!--
        Physical data tables are created at runtime, in both the dt_ and edt_ pools, so they cannot be named in a
        changeset. This backfills the row owner columns onto the ones that already exist; tables created from here on
        get the columns from createTable.
    -->
    <changeSet id="20260901000001-1" author="Ivica Cardic">
        <customChange class="com.bytechef.platform.data.table.configuration.migration.DataTableOwnerColumnChange"/>
    </changeSet>
</databaseChangeLog>
