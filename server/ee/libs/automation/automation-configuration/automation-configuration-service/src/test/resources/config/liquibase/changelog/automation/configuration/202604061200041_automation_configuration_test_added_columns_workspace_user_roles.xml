<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        Test-only schema for the EE workspace_user role columns that WorkspaceUser maps (workspace_role,
        custom_role_id) and the chk_workspace_user_role_xor constraint. The production changelogs adding them
        (202604061200010 and 202604061200040) are not on this branch yet. Each changeSet is skipped when the
        production changelog has already created the object, so this file becomes inert once they land. The
        custom_role foreign key is left out because the custom_role table does not exist here.
    -->
    <changeSet id="202604061200041-1" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="workspace_user" columnName="workspace_role"/>
            </not>
        </preConditions>

        <addColumn tableName="workspace_user">
            <column name="workspace_role" type="INT" valueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="202604061200041-2" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="workspace_user" columnName="custom_role_id"/>
            </not>
        </preConditions>

        <addColumn tableName="workspace_user">
            <column name="custom_role_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="202604061200041-3" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_constraint WHERE conname = 'chk_workspace_user_role_xor'
            </sqlCheck>
        </preConditions>

        <sql>
            ALTER TABLE workspace_user ADD CONSTRAINT chk_workspace_user_role_xor
            CHECK ((workspace_role IS NOT NULL AND custom_role_id IS NULL) OR
                   (workspace_role IS NULL AND custom_role_id IS NOT NULL));
        </sql>
    </changeSet>

    <!--
        The dev seed (workspace_user.csv) inserts id 2 explicitly without advancing the identity sequence, so the
        second membership a test saves would collide with it. Move the sequence past the seeded rows.
    -->
    <changeSet id="202604061200041-4" author="Ivica Cardic">
        <sql>
            SELECT setval(
                pg_get_serial_sequence('workspace_user', 'id'),
                GREATEST((SELECT COALESCE(MAX(id), 0) FROM workspace_user), 1));
        </sql>
    </changeSet>

    <!--
        Where the production custom_role table and its workspace_user foreign key exist, seed the custom role ids the
        permission IntTests assign (5 in WorkspaceUserAuditMapperIntTest, 900 as
        WorkspacePermissionIntTestConfiguration.CUSTOM_ROLE_ID), so a membership saved under them satisfies
        fk_workspace_user_custom_role.
    -->
    <changeSet id="202604061200041-5" author="Ivica Cardic">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="custom_role"/>
        </preConditions>

        <sql>
            INSERT INTO custom_role (id, name, created_date, created_by, last_modified_date, last_modified_by, version)
            VALUES
                (5, 'Test Custom Role 5', NOW(), 'system', NOW(), 'system', 0),
                (900, 'Test Custom Role 900', NOW(), 'system', NOW(), 'system', 0)
            ON CONFLICT (id) DO NOTHING;
        </sql>
    </changeSet>
</databaseChangeLog>
