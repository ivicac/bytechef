<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        The empty <rollback/> blocks in this file are deliberate, not omissions.

        A changeset guarded by a MARK_RAN precondition can be recorded as ran without having applied its change, so
        its inverse must never run. With no rollback declared Liquibase auto-generates that inverse (dropColumn,
        dropTable, and so on) and a rollback would then destroy an object this changeset never created. An empty
        rollback leaves the object in place instead: inert, and re-applying the changeset is a no-op through the same
        precondition.
    -->

    <!--
        Workspace-agnostic ai_gateway tables. Extracted from automation/ai_gateway/00000000000001_ai_gateway_init.xml
        so the platform tier owns the entity tables it uses; the workspace_ai_gateway_* membership tables stay in
        automation/ai_gateway/. Loaded BEFORE automation/ai_gateway/ in master.xml so the workspace_*-tables' FKs
        can resolve.

        For upgraded databases that already ran the original monolithic 00000000000001 changeset, every changeset
        in this file has a MARK_RAN preCondition keyed on a representative table — the changeset is recorded as
        "run" without re-attempting the create.
    -->
    <changeSet id="20260507000001" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_gateway_provider"/>
            </not>
        </preConditions>

        <createTable tableName="ai_gateway_provider">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="api_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="base_url" type="VARCHAR(512)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="config" type="TEXT"/>
            <column name="workspace_id" type="BIGINT"/>
            <!-- A provider belongs to at most one workspace or one connected user (see the check constraint just
                 below), never both. Schema is branch-only/unreleased, so this column is added to the init
                 changelog in place rather than as a new changeset — same convention this changelog already
                 follows. No environment column: ConnectedUser already carries environment, so the same external
                 id in two environments is two connected user rows with two ids. -->
            <column name="connected_user_id" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE ai_gateway_provider
            ADD CONSTRAINT ck_ai_gateway_provider_workspace_connected_user_not_both
            CHECK (workspace_id IS NULL OR connected_user_id IS NULL)
        </sql>

        <!-- At most one provider per (connected_user_id, type): a customer may legitimately hold one BYOK provider
             per provider type (unlike routing policy, which is single-column because a connected user has at most
             one policy at all). Without this, AiGatewayProviderService#fetchProviderByConnectedUserIdAndType has no
             way to pick a winner deterministically if two rows for the same connected user and type exist — and
             "which of a customer's API keys gets used, and billed" is not a place non-determinism belongs. Partial
             so rows with a null connected_user_id (workspace-scoped or unscoped providers) are unconstrained by it. -->
        <sql>CREATE UNIQUE INDEX uk_ai_gateway_provider_connected_user_id_type ON ai_gateway_provider (connected_user_id, type) WHERE connected_user_id IS NOT NULL;</sql>

        <createTable tableName="ai_gateway_budget">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT"/>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="period" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="enforcement_mode" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="alert_threshold" type="INT" defaultValueNumeric="80">
                <constraints nullable="false"/>
            </column>
            <column name="week_starts_on" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="ai_gateway_routing_policy">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(256)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="strategy" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="fallback_model" type="VARCHAR(256)"/>
            <column name="config" type="TEXT"/>
            <column name="workspace_id" type="BIGINT"/>
            <!-- A routing policy belongs to at most one workspace or one connected user (see the check constraint
                 just below), never both. Schema is branch-only/unreleased, so this column is added to the init
                 changelog in place rather than as a new changeset — same convention this changelog already
                 follows. No environment column: ConnectedUser already carries environment, so the same external
                 id in two environments is two connected user rows with two ids. -->
            <column name="connected_user_id" type="BIGINT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE ai_gateway_routing_policy
            ADD CONSTRAINT ck_ai_gateway_routing_policy_workspace_connected_user_not_both
            CHECK (workspace_id IS NULL OR connected_user_id IS NULL)
        </sql>

        <!-- One default routing policy per connected user: a second policy scoped to a connected user who already
             has one is rejected. Partial so rows with a null connected_user_id (workspace-scoped or unscoped
             policies) are unconstrained by it. -->
        <sql>CREATE UNIQUE INDEX uk_ai_gateway_routing_policy_connected_user_id ON ai_gateway_routing_policy (connected_user_id) WHERE connected_user_id IS NOT NULL;</sql>

        <createTable tableName="ai_gateway_model_deployment">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="routing_policy_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ai_llm_gw_deploy_policy" references="ai_gateway_routing_policy(id)"/>
            </column>
            <column name="model_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="weight" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="priority_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="max_rpm" type="INT"/>
            <column name="max_tpm" type="INT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <!-- AiGatewayModelDeployment declares @Version private int version, but this table never carried a
                 version column: every real INSERT through Spring Data JDBC's repository failed with "column
                 version does not exist" (surfaced by the phase-2 end-to-end test, the first test to persist a
                 deployment against a real database rather than a mock). Schema is branch-only/unreleased (same
                 file Task 1 already re-verified against the latest release tag), so the column is added to the
                 init changelog in place rather than as a new changeset, matching every other in-place edit here. -->
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="ai_gateway_spend_summary">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="api_key_id" type="BIGINT"/>
            <column name="project_id" type="BIGINT"/>
            <column name="model" type="VARCHAR(256)"/>
            <column name="provider" type="VARCHAR(64)"/>
            <column name="period_start" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="request_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_input_tokens" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_output_tokens" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_cost" type="DECIMAL(12,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT"/>
            <!-- Unlike ai_gateway_provider/ai_gateway_routing_policy above, workspace_id and connected_user_id are
                 NOT mutually exclusive here and there is deliberately no check constraint enforcing it either way:
                 AiGatewaySpendRollupJob writes one row per workspace for every rollup period, so workspace_id is
                 always set on a rollup row; connected_user_id narrows that same row to one customer within the
                 workspace — an intersection (workspace, connected user, period), not an alternative to it. Schema
                 is branch-only/unreleased, so this column is added to the init changelog in place rather than as a
                 new changeset — same convention this changelog already follows. No environment column:
                 ConnectedUser already carries environment, so the same external id in two environments is two
                 connected user rows with two ids. -->
            <column name="connected_user_id" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Supports the connected-user analogue of AiGatewaySpendSummaryRepository#findAllByWorkspaceIdAndPeriodStartBetween. -->
        <sql>CREATE INDEX idx_ai_gateway_spend_summary_connected_user_period ON ai_gateway_spend_summary (connected_user_id, period_start);</sql>
        <rollback/>
    </changeSet>

    <changeSet id="20260507000002" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_gateway_project"/>
            </not>
        </preConditions>

        <createTable tableName="ai_gateway_project">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="routing_policy_id" type="BIGINT"/>
            <column name="compression_enabled" type="BOOLEAN"/>
            <column name="retry_max_attempts" type="INT"/>
            <column name="timeout_seconds" type="INT"/>
            <column name="caching_enabled" type="BOOLEAN"/>
            <column name="cache_ttl_minutes" type="INT"/>
            <column name="log_retention_days" type="INT"/>
            <column name="workspace_id" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_ai_gateway_project_routing_policy" baseTableName="ai_gateway_project" baseColumnNames="routing_policy_id" referencedTableName="ai_gateway_routing_policy" referencedColumnNames="id"/>
        <rollback/>
    </changeSet>

    <!--
        Routing-policy ↔ tag join. Mirrors automation/configuration's project_tag pattern: composite PK on
        (ai_gateway_routing_policy_id, tag_id), no surrogate id, no audit columns. Tags are workspace-agnostic
        global rows from the platform `tag` table.
    -->
    <changeSet id="20260507000003" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_gateway_routing_policy_tag"/>
            </not>
        </preConditions>

        <createTable tableName="ai_gateway_routing_policy_tag">
            <column name="ai_gateway_routing_policy_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="ai_gateway_routing_policy_tag"
                       columnNames="ai_gateway_routing_policy_id,tag_id"/>

        <addForeignKeyConstraint baseTableName="ai_gateway_routing_policy_tag"
                                 baseColumnNames="ai_gateway_routing_policy_id"
                                 referencedTableName="ai_gateway_routing_policy" referencedColumnNames="id"
                                 constraintName="fk_ai_gateway_routing_policy_tag_policy"/>

        <addForeignKeyConstraint baseTableName="ai_gateway_routing_policy_tag"
                                 baseColumnNames="tag_id"
                                 referencedTableName="tag" referencedColumnNames="id"
                                 constraintName="fk_ai_gateway_routing_policy_tag_tag"/>
        <rollback/>
    </changeSet>

    <changeSet id="20260507000004" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_gateway_rate_limit"/>
            </not>
        </preConditions>

        <createTable tableName="ai_gateway_rate_limit">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1050">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT"/>
            <column name="name" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="scope" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="property_key" type="VARCHAR(256)"/>
            <column name="limit_type" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="limit_value" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="window_seconds" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback/>
    </changeSet>

    <!--
        The persisted model catalog moved to platform/ai/model_catalog as ai_model. These constraints belong to the
        gateway (which knows the catalog; the catalog must not know the gateway): the provider FK onto ai_model and
        the deployment FK pointing at it. tableExists-guarded because module-scoped test contexts may load this
        changelog without the catalog's.
    -->
    <changeSet id="20260812000001" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="ai_model"/>
        </preConditions>

        <addForeignKeyConstraint constraintName="fk_ai_model_provider" baseTableName="ai_model" baseColumnNames="provider_id" referencedTableName="ai_gateway_provider" referencedColumnNames="id"/>
        <rollback/>
    </changeSet>

    <changeSet id="20260812000002" author="ivicac">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="ai_model"/>
        </preConditions>

        <addForeignKeyConstraint constraintName="fk_ai_llm_gw_deploy_model" baseTableName="ai_gateway_model_deployment" baseColumnNames="model_id" referencedTableName="ai_model" referencedColumnNames="id"/>
        <rollback/>
    </changeSet>
</databaseChangeLog>
