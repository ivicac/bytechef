<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--
        A conversation's minted PII tokens, carried across turns. tokens holds the encrypted JSON of the whole
        token-to-value map as ONE blob per row, not per-value columns, because the values it protects ARE the
        caller's real PII.

        No new includeAll line is needed in master.xml, because this directory is already registered by the
        ai_guardrail_violation changeset, and includeAll picks up whatever is in it. That is exactly why this changeset
        has an integration test: a directory registered with errorIfMissingOrEmpty="false" fails silently, so "the
        table exists" is a claim only a real database can settle.
    -->
    <changeSet id="20260905000001" author="Ivica Cardic">
        <createTable tableName="ai_guardrail_token_session">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="conversation_id" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="tokens" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!--
            One stored session per conversation per user. A chat is deleted as a whole (see
            deleteByWorkspaceIdAndConversationId), but two participants in the same conversation each keep their own
            row, since the caller-supplied userId is part of the key.
        -->
        <addUniqueConstraint tableName="ai_guardrail_token_session" columnNames="workspace_id,user_id,conversation_id"
                             constraintName="uk_ai_guardrail_token_session_workspace_user_conversation"/>

        <!-- Feeds the TTL sweep (Task 6): finds every session whose row has not moved since a cutoff. -->
        <createIndex tableName="ai_guardrail_token_session" indexName="idx_ai_guardrail_token_session_last_modified_date">
            <column name="last_modified_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
