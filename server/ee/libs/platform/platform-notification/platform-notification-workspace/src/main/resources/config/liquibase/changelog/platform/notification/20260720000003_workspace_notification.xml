<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Workspace membership for CE notifications: no membership row = global (pre-scoping behavior), a
         membership row scopes the notification to that workspace. Lives in the EE platform-notification-workspace
         module; the CE notification table stays untouched. -->
    <changeSet id="20260720000003-1" author="Ivica Cardic">
        <createTable tableName="workspace_notification">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="notification_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="workspace_notification" columnNames="workspace_id,notification_id"
            constraintName="uq_workspace_notification"/>

        <addForeignKeyConstraint
            baseTableName="workspace_notification"
            baseColumnNames="notification_id"
            constraintName="fk_workspace_notification_notification_id"
            referencedTableName="notification"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createIndex tableName="workspace_notification" indexName="idx_workspace_notification_workspace">
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
